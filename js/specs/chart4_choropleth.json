{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 560,
  "height": 430,

  "projection": {
    "type": "conicEqualArea",
    "parallels": [-18, -36],
    "rotate": [-134, 0, 0],
    "center": [0, -25]
  },

  "layer": [
    {
      "data": {
        "url": "data/maps/australia_states.json",
        "format": {
          "type": "topojson",
          "feature": "STE_2026_AUST_GDA2020"
        }
      },

      "transform": [
        {
          "lookup": "properties.STE_NAME26",
          "from": {
            "data": {
              "url": "data/state_bushwalking.csv"
            },
            "key": "state_name",
            "fields": [
              "state",
              "participation_rate_pct",
              "estimated_participants"
            ]
          }
        }
      ],

      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 1
      },

      "encoding": {
        "color": {
          "field": "participation_rate_pct",
          "type": "quantitative",
          "title": "Participation rate (%)",
          "scale": {
            "range": [
              "#E7F1ED",
              "#B8D5CB",
              "#7FB2A0",
              "#3F7C68",
              "#174C3C"
            ]
          }
        },

        "tooltip": [
          {
            "field": "properties.STE_NAME26",
            "type": "nominal",
            "title": "State / territory"
          },
          {
            "field": "participation_rate_pct",
            "type": "quantitative",
            "title": "Participation rate (%)",
            "format": ".1f"
          },
          {
            "field": "estimated_participants",
            "type": "quantitative",
            "title": "Estimated participants",
            "format": ","
          }
        ]
      }
    },

    {
      "data": {
        "values": [
          {
            "group": "ACT",
            "order": 1,
            "longitude": 149.13,
            "latitude": -35.28
          },
          {
            "group": "ACT",
            "order": 2,
            "longitude": 151.78,
            "latitude": -35.18
          }
        ]
      },

      "mark": {
        "type": "line",
        "stroke": "#5e6a64",
        "strokeWidth": 1.2
      },

      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "detail": {
          "field": "group"
        },
        "order": {
          "field": "order"
        }
      }
    },

    {
      "data": {
        "values": [
          {
            "label": "ACT · 26.8%",
            "longitude": 151.82,
            "latitude": -35.16
          }
        ]
      },

      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 11,
        "fontWeight": 700,
        "align": "left",
        "baseline": "middle",
        "color": "#33413b"
      },

      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    }
  ]
}