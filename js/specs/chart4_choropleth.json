{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 560,
  "height": 430,

  "title": {
    "text": "Tasmania and the ACT have the highest hiking participation rates",
    "subtitle": "Share of adults participating in “Bush walking”, 2025",
    "anchor": "start"
  },

  "data": {
    "url": "data/maps/australia_states.json",
    "format": {
      "type": "topojson",
      "feature": "STE_2026_AUST_GDA2020"
    }
  },

  "transform": [
    {
      "lookup": "properties.STE_NAME26",
      "from": {
        "data": {
          "url": "data/state_bushwalking.csv"
        },
        "key": "state_name",
        "fields": [
          "state",
          "participation_rate_pct",
          "estimated_participants"
        ]
      }
    }
  ],

  "projection": {
    "type": "conicEqualArea",
    "parallels": [-18, -36],
    "rotate": [-134, 0, 0],
    "center": [0, -25]
  },

  "mark": {
    "type": "geoshape",
    "stroke": "white",
    "strokeWidth": 1
  },

  "encoding": {
    "color": {
      "field": "participation_rate_pct",
      "type": "quantitative",
      "title": "Participation rate (%)",
      "scale": {
        "scheme": "greens"
      }
    },

    "tooltip": [
      {
        "field": "properties.STE_NAME26",
        "type": "nominal",
        "title": "State / territory"
      },
      {
        "field": "participation_rate_pct",
        "type": "quantitative",
        "title": "Participation rate",
        "format": ".1f"
      },
      {
        "field": "estimated_participants",
        "type": "quantitative",
        "title": "Estimated participants",
        "format": ","
      }
    ]
  }
}