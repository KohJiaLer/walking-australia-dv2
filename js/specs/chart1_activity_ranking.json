{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Top 10 adult physical activities in Australia, 2025, with bush walking highlighted.",

  "width": 720,
  "height": 340,

  "data": {
    "url": "data/activity_ranking.csv"
  },

  "transform": [
    {
      "calculate": "datum.activity == 'Bush walking' ? 'Bush walking' : 'Other activities'",
      "as": "group"
    }
  ],

  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 3
  },

  "encoding": {
    "y": {
      "field": "activity",
      "type": "nominal",
      "sort": "-x",
      "title": null,
      "axis": {
        "labelLimit": 180
      }
    },

    "x": {
      "field": "participation_rate_pct",
      "type": "quantitative",
      "title": "Adult participation rate (%)",
      "scale": {
        "zero": true,
        "domain": [0, 55]
      },
      "axis": {
        "format": ".0f",
        "values": [0, 5, 10, 15, 20, 25, 30, 35, 40, 45, 50, 55],
        "gridColor": "#E5E8E6",
        "gridOpacity": 0.8
      }
    },

    "color": {
      "field": "group",
      "type": "nominal",
      "scale": {
        "domain": [
          "Bush walking",
          "Other activities"
        ],
        "range": [
          "#355C4D",
          "#C9D2CE"
        ]
      },
      "legend": null
    },

    "tooltip": [
      {
        "field": "activity",
        "type": "nominal",
        "title": "Activity"
      },
      {
        "field": "participation_rate_pct",
        "type": "quantitative",
        "title": "Participation rate (%)",
        "format": ".1f"
      }
    ]
  },

  "title": {
    "text": "Hiking ranks third among Australia's most popular activities",
    "subtitle": "Adult participation rate, January–December 2025 • AusPlay category: “Bush walking”",
    "anchor": "start"
  }
}