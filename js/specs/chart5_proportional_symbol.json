{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 560,
  "height": 430,

  "title": {
    "text": "New South Wales has the largest number of bushwalkers",
    "subtitle": "Estimated adult bushwalking participants by state and territory, 2025",
    "anchor": "start"
  },

  "layer": [
    {
      "data": {
        "url": "/data/maps/australia_states.json",
        "format": {
          "type": "topojson",
          "feature": "STE_2026_AUST_GDA2020"
        }
      },

      "projection": {
        "type": "mercator"
      },

      "mark": {
        "type": "geoshape",
        "fill": "#F0F2EF",
        "stroke": "#8C9892",
        "strokeWidth": 1
      }
    },

    {
      "data": {
        "url": "../../data/state_bushwalking.csv"
      },

      "projection": {
        "type": "mercator"
      },

      "mark": {
        "type": "circle",
        "opacity": 0.75,
        "stroke": "white",
        "strokeWidth": 1
      },

      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },

        "size": {
          "field": "estimated_participants",
          "type": "quantitative",
          "title": "Estimated participants",
          "scale": {
            "range": [100, 3000]
          },
          "legend": {
            "format": ".2s"
          }
        },

        "color": {
          "value": "#355C4D"
        },

        "tooltip": [
          {
            "field": "state_name",
            "type": "nominal",
            "title": "State / territory"
          },
          {
            "field": "estimated_participants",
            "type": "quantitative",
            "title": "Estimated participants",
            "format": ","
          },
          {
            "field": "participation_rate_pct",
            "type": "quantitative",
            "title": "Participation rate",
            "format": ".1f"
          }
        ]
      }
    }
  ]
}