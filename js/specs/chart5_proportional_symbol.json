{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 560,
  "height": 430,

  "projection": {
    "type": "conicEqualArea",
    "parallels": [-18, -36],
    "rotate": [-134, 0, 0],
    "center": [0, -25]
  },

  "layer": [
    {
      "data": {
        "url": "data/maps/australia_states.json",
        "format": {
          "type": "topojson",
          "feature": "STE_2026_AUST_GDA2020"
        }
      },

      "mark": {
        "type": "geoshape",
        "fill": "#F0F2EF",
        "stroke": "#8C9892",
        "strokeWidth": 1
      }
    },

    {
      "data": {
        "url": "data/state_bushwalking.csv"
      },

      "mark": {
        "type": "circle",
        "opacity": 0.75,
        "stroke": "white",
        "strokeWidth": 1
      },

      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },

        "size": {
          "field": "estimated_participants",
          "type": "quantitative",
          "title": "Estimated participants",
          "scale": {
            "range": [40, 1400]
          },
          "legend": {
            "title": "Estimated participants",
            "values": [200000, 600000, 1000000, 1200000],
            "format": ".2s"
          }
        },

        "color": {
          "value": "#667D76"
        },

        "tooltip": [
          {
            "field": "state_name",
            "type": "nominal",
            "title": "State / territory"
          },
          {
            "field": "estimated_participants",
            "type": "quantitative",
            "title": "Estimated participants",
            "format": ","
          },
          {
            "field": "participation_rate_pct",
            "type": "quantitative",
            "title": "Participation rate (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "group": "ACT",
            "order": 1,
            "longitude": 149.13,
            "latitude": -35.28
          },
          {
            "group": "ACT",
            "order": 2,
            "longitude": 151.22,
            "latitude": -35.20
          }
        ]
      },
      "mark": {
        "type": "line",
        "stroke": "#5e6a64",
        "strokeWidth": 1.2
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "detail": {
          "field": "group"
        },
        "order": {
          "field": "order"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "label": "ACT",
            "longitude": 151.5,
            "latitude": -35.08
          }
        ]
      },
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 11,
        "fontWeight": 700,
        "align": "left",
        "baseline": "middle",
        "color": "#33413b"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    }
  ]
}