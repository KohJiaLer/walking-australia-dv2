{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 520,
  "height": 330,

  "title": {
    "text": "Greater Sydney increasingly dominates park visitation",
    "subtitle": "Estimated domestic visits to NPWS parks by branch and survey year",
    "anchor": "start"
  },

  "data": {
    "url": "../../data/branch_visitation_history.csv"
  },

  "mark": {
    "type": "rect",
    "stroke": "white",
    "strokeWidth": 1
  },

  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": "Survey year",
      "sort": [
        "2008",
        "2010",
        "2012",
        "2014",
        "2016",
        "2018",
        "2020",
        "2022",
        "FY24-25"
      ],
      "axis": {
        "labelAngle": 0
      }
    },

    "y": {
      "field": "branch",
      "type": "nominal",
      "title": null,
      "sort": [
        "Greater Sydney",
        "Blue Mountains",
        "Hunter Central Coast",
        "South Coast",
        "North Coast",
        "West",
        "Southern Ranges",
        "Northern Inland"
      ]
    },

    "color": {
      "field": "visits",
      "type": "quantitative",
      "title": "Estimated visits",
      "scale": {
        "scheme": "greens"
      },
      "legend": {
        "format": ".2s"
      }
    },

    "tooltip": [
      {
        "field": "branch",
        "type": "nominal",
        "title": "NPWS branch"
      },
      {
        "field": "year",
        "type": "ordinal",
        "title": "Survey year"
      },
      {
        "field": "visits",
        "type": "quantitative",
        "title": "Estimated visits",
        "format": ","
      }
    ]
  }
}