{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 700,
  "height": 320,

  "data": {
    "url": "data/bushwalking_age_organised.csv"
  },

  "encoding": {
    "y": {
      "field": "age_group",
      "type": "ordinal",
      "title": "Age group",
      "sort": [
        "15-17",
        "18-24",
        "25-34",
        "35-44",
        "45-54",
        "55-64",
        "65+"
      ]
    }
  },

  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 3,
        "color": "#C5CBC8"
      },

      "encoding": {
        "x": {
          "field": "organised_participation_pct",
          "type": "quantitative",
          "title": "Participation rate (%)",
          "scale": {
            "domain": [0, 25],
            "nice": false
          }
        },

        "x2": {
          "field": "total_participation_pct"
        }
      }
    },

    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 100,
        "color": "#A87C4F"
      },

      "encoding": {
        "x": {
          "field": "organised_participation_pct",
          "type": "quantitative"
        },

        "tooltip": [
          {
            "field": "age_group",
            "type": "ordinal",
            "title": "Age group"
          },
          {
            "field": "organised_participation_pct",
            "type": "quantitative",
            "title": "Organised participation (%)",
            "format": ".1f"
          }
        ]
      }
    },

    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 120,
        "color": "#4C7180"
      },

      "encoding": {
        "x": {
          "field": "total_participation_pct",
          "type": "quantitative"
        },

        "tooltip": [
          {
            "field": "age_group",
            "type": "ordinal",
            "title": "Age group"
          },
          {
            "field": "total_participation_pct",
            "type": "quantitative",
            "title": "Total participation (%)",
            "format": ".1f"
          }
        ]
      }
    }
  ]
}